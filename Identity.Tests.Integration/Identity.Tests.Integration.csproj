<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Identity.Tests.Integration</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\AlwaysPassCAPTCHAService.cs" Link="Host\AlwaysPassCAPTCHAService.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\E2ESettings.cs" Link="Host\E2ESettings.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\EmailCaptureSender.cs" Link="Host\EmailCaptureSender.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\FakeExternalAuthenticationHandler.cs" Link="Host\FakeExternalAuthenticationHandler.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\FakeGoogleClaims.cs" Link="Host\FakeGoogleClaims.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\FakeGoogleSchemeProvider.cs" Link="Host\FakeGoogleSchemeProvider.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\IdentityHostFixture.cs" Link="Host\IdentityHostFixture.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\IdentityWebApplicationFactory.cs" Link="Host\IdentityWebApplicationFactory.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\NullAvatarService.cs" Link="Host\NullAvatarService.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\OidcStandardConstants.cs" Link="Host\OidcStandardConstants.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\RecordingCommandInterceptor.cs" Link="Host\RecordingCommandInterceptor.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\ServiceBusConstants.cs" Link="Host\ServiceBusConstants.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\TestDatabaseContract.cs" Link="Host\TestDatabaseContract.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\TestDatabaseContractConstants.cs" Link="Host\TestDatabaseContractConstants.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\TestServiceBusClient.cs" Link="Host\TestServiceBusClient.cs" />
    <Compile Include="..\Identity.Tests.E2E\Infrastructure\TestServiceBusClientFactory.cs" Link="Host\TestServiceBusClientFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shared.Testing" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Shared" Version="1.5.1" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Identity\Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\CustomDictionary.xml" />
  </ItemGroup>

</Project>
