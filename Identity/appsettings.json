{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "AllowedHosts": "*",
  "CorsPolicy": {
    "Origins": []
  },
  "SqlConnectionStringBuilder": {
    "DataSource": null,
    "InitialCatalog": "Identity",
    "IntegratedSecurity": false,
    "ConnectTimeout": 30,
    "Encrypt": true,
    "TrustServerCertificate": false,
    "ApplicationIntent": "ReadWrite",
    "MultiSubnetFailover": false,
    "CommandTimeout": 30
  },
  "QuerySplittingBehavior": "SingleQuery",
  "PasskeyOrigin": null,
  "ReCAPTCHASiteKey": null,
  "ReCAPTCHASecretKey": null,
  "ReCAPTCHAVerifyEndpoint": "https://www.google.com/recaptcha/api/siteverify",
  "ReCAPTCHAScriptEndpoint": "https://www.google.com/recaptcha/api.js",
  "AccountEmailSettings": {
    "Sender": "noreply@crgolden.com",
    "ConfirmAccountHtmlFormat": "Please confirm your account by <a href='{0}'>clicking here</a>.",
    "ResetPasswordHtmlFormat": "Please reset your password by <a href='{0}'>clicking here</a>."
  },
  "ConsentOptions": {
    "EnableOfflineAccess": true,
    "OfflineAccessDisplayName": "Offline Access",
    "OfflineAccessDescription": "Access to your applications and resources, even when you are offline."
  },
  "TelemetryOptions": {
    "ConsentGrantedDescription": "Number of consent grants by users.",
    "ConsentDeniedDescription": "Number of consent denials by users.",
    "GrantsRevokedDescription": "Number of client grants revoked by users.",
    "ExceptionDescription": "Number of unhandled exceptions.",
    "PasskeySignInDescription": "Number of passkey sign-in attempts, split by outcome and by whether the caller identifies itself as synthetic."
  },
  "AdminSections": [
    {
