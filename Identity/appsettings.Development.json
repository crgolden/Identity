{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "DetailedErrors": true,
  "CorsPolicy": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "SqlConnectionStringBuilder": {
    "DataSource": "(localdb)\\MSSQLLocalDB",
    "IntegratedSecurity": true
  },
  "PasskeyOrigin": "https://localhost:7261",
  "GoogleClientId": null,
  "GoogleClientSecret": null,
  "ResendApiToken": null,
  "RecaptchaSiteKey": null,
  "RecaptchaSecretKey": null,
  "ServiceBusConnectionString": null,
  "PlaywrightSettings": {
    "Headless": true,
    "TestResultsFolderName": "TestResults",
    "ArtifactsFolderName": "PlaywrightArtifacts",
    "TempFolderName": ".tmp",
    "ScreenshotFileName": "screenshot.png",
    "TraceFileName": "trace.zip",
    "BrowserLogFileName": "browser-log.txt",
    "MetadataFileName": "metadata.json",
    "FailureFileName": "failure.json",
    "RecordedVideoWidth": 1280,
    "RecordedVideoHeight": 720,
    "MaxArtifactNameLength": 120
  },
  "E2ESettings": {
    "TestCatalogSuffix": "Test",
    "IndependentlyPinnedAdminCardCount": 16
  },
  "LoadSettings": {
    "RequestScale": 1,
    "MaxRequests": 100000,
    "MaxFailRate": 0.01,
    "MaxLoginFailRate": 0.02,
    "DiscoveryRequests": 100,
    "DiscoveryParallelism": 10,
    "LoginRequests": 60,
    "LoginParallelism": 10,
    "JwksRequests": 100,
    "JwksParallelism": 20,
    "HealthRequests": 40,
    "HealthParallelism": 5
  }
}
