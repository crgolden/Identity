@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject Microsoft.Extensions.Options.IOptions<IReadOnlyList<ManageSection>> ManageSections
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var sections = ManageSections.Value.Where(nav => hasExternalLogins || !nav.RequiresExternalLogins);
}
<ul id="manage-sections" class="nav nav-pills flex-column">
    @foreach (var nav in sections)
    {
        <li class="nav-item"><a class="nav-link @ManageNavPages.PageNavClass(ViewContext, nav.Page)" id="@nav.LinkId" asp-page="@nav.AspPage">@nav.Title</a></li>
    }
</ul>
