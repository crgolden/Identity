@page
@model IndexModel
@inject SignInManager<IdentityUser<Guid>> SignInManager
@{
    var signedIn = SignInManager.IsSignedIn(User);
    ViewData["Title"] = signedIn ? "Home" : "Sign in";
    if (!signedIn)
    {
        ViewData["Description"] = "One account for every application connected to this sign-in service. Passkeys, two-factor authentication, and Google sign-in, with full control over what each application can see.";
    }
}

@if (signedIn)
{
    <h1>Your account. Every app you connected.</h1>

    <p id="signed-in-lead" class="lead">Signed in as @User.Identity?.Name. Change how you sign in, review which applications have access, or sign your other devices out.</p>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a id="manage-account" asp-page="/Account/Manage/Index" class="btn btn-primary">Manage your account</a>
        <a id="review-grants" asp-page="/Account/Manage/Grants" class="btn btn-outline-secondary">Application access</a>
        @if (User.IsInRole("Admin"))
        {
            <a id="home-admin" asp-page="/Admin/Index" class="btn btn-outline-secondary">Admin</a>
        }
    </div>
}
else
{
    <h1>One account. Every app you connect.</h1>

    <p class="lead">Register once here. Any application connected to this service sends you back when it needs to know who you are &mdash; so none of them ever stores your password.</p>

    <p class="mb-4">
        <a id="create-account" asp-page="/Account/Register" class="btn btn-primary">Create an account</a>
        <a id="sign-in" asp-page="/Account/Login" class="btn btn-outline-secondary ms-1">Sign in</a>
    </p>
}

<div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Three ways in</h2>
                <p class="card-text">Email and password, a passkey, or your Google account. Passkeys use your device's own fingerprint, face, or PIN &mdash; nothing to guess, nothing to reuse.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Locked down by default</h2>
                <p class="card-text">Two-factor authentication with any authenticator app, backed by recovery codes. Register several passkeys so one lost device can't shut you out.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Apps see almost nothing</h2>
                <p class="card-text">Just your username and the exact permissions you approved &mdash; never your password. You see that list before you agree to it.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Revoke anything, anytime</h2>
                <p class="card-text">Cut off any application's access, sign other devices out, download everything held about you, or delete the account outright.</p>
            </div>
        </div>
    </div>
</div>

<p class="text-muted">
    @if (!signedIn)
    {
        <text>Already registered? <a asp-page="/Account/Manage/Index">Manage your account</a>.</text>
    }
    Read the <a asp-page="/Privacy">privacy policy</a>, or browse the source at
    <a href="https://github.com/crgolden/Identity">github.com/crgolden/Identity</a>.
</p>
