@page "{id:int}"
@model Identity.Pages.Admin.ApiResources.Edit.Secrets
@{
    ViewData["Title"] = $"Edit API Resource Secrets - {Model.ResourceName}";
}

<h1 id="page-heading">@Model.ResourceName - Edit Secrets</h1>

<form method="post">
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm">
            <thead>
                <tr><th>Description</th><th>Type</th><th>Expiration</th><th>Value (new only)</th><th class="visually-hidden">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Enumerable.Range(0, Model.Resources.Count))
                {
                    <tr>
                        <input type="hidden" name="Resources[@i].Id" value="@Model.Resources[i].Id" />
                        <td><input id="secret-description-@i" name="Resources[@i].Description" value="@Model.Resources[i].Description" class="form-control form-control-sm" aria-label="Description" /></td>
                        <td><input id="secret-type-@i" name="Resources[@i].Type" value="@Model.Resources[i].Type" class="form-control form-control-sm" aria-label="Secret type" /></td>
                        <td><input id="secret-expiration-@i" name="Resources[@i].Expiration" value="@Model.Resources[i].Expiration" type="datetime-local" class="form-control form-control-sm" aria-label="Expiration" /></td>
                        <td>
                            @if (Model.Resources[i].Id == 0)
                            {
                                <input id="secret-value-@i" name="Resources[@i].Value" type="password" class="form-control form-control-sm" placeholder="Value" aria-label="Secret value" />
                            }
                        </td>
                        <td><button id="secret-remove-@i" type="submit" asp-page-handler="RemoveRow" asp-route-id="@Model.ResourceId" asp-route-index="@i" class="btn btn-sm btn-danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button id="btn-add-row" type="submit" asp-page-handler="AddRow" asp-route-id="@Model.ResourceId" class="btn btn-sm btn-outline-secondary mb-3">Add Secret</button>
    <div>
        <button id="save-submit" type="submit" asp-route-id="@Model.ResourceId" class="btn btn-primary">Save</button>
        <a asp-page="../Details/Secrets" asp-route-id="@HttpContext.Request.RouteValues["id"]" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
