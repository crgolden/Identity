@page "{id:int}"
@model Identity.Pages.Admin.ApiResources.Details.Scopes
@{
    ViewData["Title"] = $"API Resource Scopes - {Model.Resource.Name}";
}

<h1 id="page-heading">@Model.Resource.Name - Scopes</h1>

<div class="table-responsive">
    <table id="page-table" class="table table-bordered table-hover table-sm">
        <thead>
            <tr><th>Scope</th></tr>
        </thead>
        <tbody>
            @foreach (var scope in Model.Resources)
            {
                <tr id="scope-row-@scope.Id"><td>@scope.Scope</td></tr>
            }
        </tbody>
    </table>
</div>

<a id="btn-edit" asp-page="../Edit/Scopes" asp-route-id="@Model.Resource.Id" class="btn btn-primary">Edit</a>
<a id="btn-back" asp-page="./Index" asp-route-id="@Model.Resource.Id" class="btn btn-outline-secondary">Back</a>
