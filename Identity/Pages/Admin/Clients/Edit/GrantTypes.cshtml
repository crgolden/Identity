@page
@model GrantTypes

@{
    ViewData["Title"] = "Edit Client Grant Types";
}

<h1 id="page-heading">Edit Client Grant Types</h1>

<form method="post">
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm">
            <thead>
                <tr>
                    <th>Grant Type</th>
                    <th class="visually-hidden">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Enumerable.Range(0, Model.Resources.Count))
                {
                    <tr>
                        <input type="hidden" name="Resources[@i].Id" value="@Model.Resources[i].Id" />
                        <td><input id="granttype-@i" name="Resources[@i].GrantType" value="@Model.Resources[i].GrantType" class="form-control form-control-sm" aria-label="Grant type" /></td>
                        <td><button id="granttype-remove-@i" type="submit" asp-page-handler="RemoveRow" asp-route-id="@Model.Client.Id" asp-route-index="@i" class="btn btn-sm btn-danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button id="btn-add-row" type="submit" asp-page-handler="AddRow" asp-route-id="@Model.Client.Id" class="btn btn-sm btn-outline-secondary mb-3">Add</button>
    <div>
        <button id="save-submit" type="submit" asp-route-id="@Model.Client.Id" class="btn btn-primary">Save</button>
        <a asp-page="/Admin/Clients/Details/GrantTypes" asp-route-id="@Model.Client.Id" class="btn btn-outline-secondary ms-1">Cancel</a>
    </div>
</form>
