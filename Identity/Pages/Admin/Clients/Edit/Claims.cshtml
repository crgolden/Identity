@page
@model Claims

@{
    ViewData["Title"] = "Edit Client Claims";
}

<h1 id="page-heading">Edit Client Claims</h1>

<form method="post">
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <th class="visually-hidden">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Enumerable.Range(0, Model.Resources.Count))
                {
                    <tr>
                        <input type="hidden" name="Resources[@i].Id" value="@Model.Resources[i].Id" />
                        <td><input id="claim-type-@i" name="Resources[@i].Type" value="@Model.Resources[i].Type" class="form-control form-control-sm" aria-label="Claim type" /></td>
                        <td><input id="claim-value-@i" name="Resources[@i].Value" value="@Model.Resources[i].Value" class="form-control form-control-sm" aria-label="Claim value" /></td>
                        <td><button id="claim-remove-@i" type="submit" asp-page-handler="RemoveRow" asp-route-id="@Model.Client.Id" asp-route-index="@i" class="btn btn-sm btn-danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button id="btn-add-row" type="submit" asp-page-handler="AddRow" asp-route-id="@Model.Client.Id" class="btn btn-sm btn-outline-secondary mb-3">Add</button>
    <div>
        <button id="save-submit" type="submit" asp-route-id="@Model.Client.Id" class="btn btn-primary">Save</button>
        <a asp-page="/Admin/Clients/Details/Claims" asp-route-id="@Model.Client.Id" class="btn btn-outline-secondary ms-1">Cancel</a>
    </div>
</form>
