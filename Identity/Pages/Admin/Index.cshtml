@page
@model Identity.Pages.Admin.Index
@inject Microsoft.Extensions.Options.IOptions<IReadOnlyList<AdminSection>> AdminSections
@{
    ViewData["Title"] = "Admin";
}

<h1 id="page-heading">Admin</h1>

<div class="row row-cols-1 row-cols-md-3 g-4 mt-1">
@foreach (var card in AdminSections.Value)
{
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@card.Title</h5>
                <p class="card-text">@card.Description</p>
                <a id="@card.CardId" asp-page="@card.Page" class="btn btn-primary">Manage</a>
            </div>
        </div>
    </div>
}
</div>
