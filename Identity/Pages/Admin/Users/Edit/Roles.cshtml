@page "{id}"
@model Identity.Pages.Admin.Users.Edit.Roles
@{
    ViewData["Title"] = "Edit User Roles";
}

<h1 id="page-heading">@Model.AppUser.UserName - Edit Roles</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm">
            <thead>
                <tr>
                    <th>Role</th>
                    <th class="visually-hidden">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Enumerable.Range(0, Model.Resources.Count))
                {
                    <tr>
                        <td><input id="@(Roles.RowIdPrefix)@i" name="Resources[@i]" value="@Model.Resources[i]" class="form-control form-control-sm" aria-label="Role name" /></td>
                        <td><button id="@(Roles.RemoveRowIdPrefix)@i" type="submit" asp-page-handler="RemoveRow" asp-route-id="@Model.AppUser.Id" asp-route-index="@i" class="btn btn-sm btn-outline-danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button id="btn-add-row" type="submit" asp-page-handler="AddRow" asp-route-id="@Model.AppUser.Id" class="btn btn-outline-secondary btn-sm mb-3">Add Role</button>
    <div>
        <button id="save-submit" type="submit" asp-route-id="@Model.AppUser.Id" class="btn btn-primary">Save</button>
        <a asp-page="../Details/Roles" asp-route-id="@Model.AppUser.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
