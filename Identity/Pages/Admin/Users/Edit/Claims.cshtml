@page "{id}"
@model Identity.Pages.Admin.Users.Edit.Claims
@{
    ViewData["Title"] = "Edit User Claims";
}

<h1 id="page-heading">@Model.AppUser.UserName - Edit Claims</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <th class="visually-hidden">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Enumerable.Range(0, Model.Resources.Count))
                {
                    <tr>
                        <td><input id="claim-type-@i" name="Resources[@i].Type" value="@Model.Resources[i].Type" class="form-control form-control-sm" aria-label="Claim type" /></td>
                        <td><input id="claim-value-@i" name="Resources[@i].Value" value="@Model.Resources[i].Value" class="form-control form-control-sm" aria-label="Claim value" /></td>
                        <td><button id="claim-remove-@i" type="submit" asp-page-handler="RemoveRow" asp-route-id="@Model.AppUser.Id" asp-route-index="@i" class="btn btn-sm btn-outline-danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button id="btn-add-row" type="submit" asp-page-handler="AddRow" asp-route-id="@Model.AppUser.Id" class="btn btn-outline-secondary btn-sm mb-3">Add Claim</button>
    <div>
        <button id="save-submit" type="submit" asp-route-id="@Model.AppUser.Id" class="btn btn-primary">Save</button>
        <a asp-page="../Details/Claims" asp-route-id="@Model.AppUser.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
