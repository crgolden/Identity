@page "{id:int}"
@model Identity.Pages.Admin.ApiScopes.Edit.ClaimTypes
@{
    ViewData["Title"] = "Edit API Scope Claim Types";
    var rows = Model.Resources.Select(c => new ClaimTypeRow(c.Id, c.Type)).ToList();
    var cancelHref = Url.Page("/Admin/ApiScopes/Details/ClaimTypes", new { id = Request.RouteValues["id"] });
}

<h1 id="page-heading">Edit Claim Types</h1>

@await Html.PartialAsync("~/Pages/Admin/Shared/_EditClaimTypesForm.cshtml", rows,
    new ViewDataDictionary(ViewData) { { "CancelHref", cancelHref }, { "EntityId", Request.RouteValues["id"] } })
