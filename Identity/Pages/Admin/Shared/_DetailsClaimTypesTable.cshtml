@model IEnumerable<ClaimTypeRow>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-sm">
        <thead>
            <tr><th>Type</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr><td>@row.Type</td></tr>
            }
        </tbody>
    </table>
</div>
