@page
@model Identity.Pages.RedirectModel
@{
    ViewData["Title"] = "Redirecting";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

</head>
<body data-redirect-uri="@Model.RedirectUri">
    <p>Redirecting to <a href="@Model.RedirectUri">@Model.RedirectUri</a>&hellip;</p>
    <script src="~/js/redirect.js" asp-append-version="true"></script>
</body>
</html>
