{
  "stryker-config": {
    "project": "Identity.csproj",
    "test-projects": [
      "../Identity.Tests.Unit/Identity.Tests.Unit.csproj"
    ],
    "reporters": [
      "html",
      "json",
      "progress",
      "dashboard"
    ],
    "project-info": {
      "name": "github.com/crgolden/Identity",
      "version": "main"
    },
    "mutation-level": "Advanced",
    "thresholds": {
      "high": 75,
      "low": 65,
      "break": 60
    },
    "mutate": [
      "**/*.cs",
      "!obj/**/*.cs",
      "!Program.cs",
      "!Properties/**/*.cs"
    ],
    "since": {
      "enabled": false
    },
    "test-runner": "mtp",
    "coverage-analysis": "perTest"
  }
}
